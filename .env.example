# Server
PORT=3000

# Telegram bot token from @BotFather (keep secret, never commit real value)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Roles by Telegram ID (comma-separated)
OWNER_IDS=111111111
MODERATOR_IDS=222222222,333333333
# ADMIN_IDS is legacy alias for moderator list
# ADMIN_IDS=

# Game plugin API (empty = mock mode with same JSON shapes)
GAME_API_URL=http://89.188.109.183:26903

# 40-char plugin key - Secret on hosting, NEVER commit real value
# Public base URL for self-ping (Render sets RENDER_EXTERNAL_URL itself, this overrides)
# PUBLIC_URL=https://xxxx.onrender.com
# MOCK=1 turns on mock data (off by default)
GAME_API_KEY=put-real-key-here-never-commit-it

# Telegram bot (runs inside this service with long polling, ON by default)
# Set ENABLE_BOT=0 on local runs - or they steal updates from the live bot
# PANEL_URL is the frontend Mini App URL for the open-panel button
#ENABLE_BOT=0
#PANEL_URL is optional now (default https://api.buildzone.lol/ is baked into bot.js)
#PANEL_URL=https://api.buildzone.lol/
